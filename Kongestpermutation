class Solution {
    public int longestKSubstr(String s, int k) {
        int left=0;
        int length=-1;
        // code here
        HashMap<Character,Integer>ans=new HashMap<>();
        for(int i=0;i<s.length();i++){
            ans.put(s.charAt(i),ans.getOrDefault(s.charAt(i),0)+1);
            if(ans.size()>k){
                while(ans.size()>k){
                    ans.put(s.charAt(left),ans.get(s.charAt(left))-1);
                    if( ans.get(s.charAt(left))==0){
                        ans.remove(s.charAt(left));
                    }
                    left++;
                }
            }
            if(ans.size()==k){
                length=Math.max(length,i-left+1);
            }
        }
        return length;
    }
}
  

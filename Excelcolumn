class Solution {
    public int titleToNumber(String columnTitle) {
        double sum=0;
        int j=0;
        for(int i=columnTitle.length()-1;i>=0;i--){
            char ch=columnTitle.charAt(i);
            if(ch<='A'|| ch>='A'){
                sum=sum+(((int)ch-(int)'A')+1)*Math.pow(26,j);
            }
            j++;
        }
        return (int)sum;
    }
}

         
